# Copy to .env and adjust. Every value is optional for local development.

NODE_ENV=development
PORT=4000

# MongoDB connection string (e.g. a free MongoDB Atlas cluster).
# Leave empty locally to use a temporary in-memory MongoDB.
MONGODB_URI=
# Database name inside the cluster (used even if the connection string names none).
MONGODB_DB_NAME=creditsea

# Required in production. Use a long random string.
JWT_SECRET=
JWT_EXPIRES_IN_DAYS=30

# Comma-separated list of allowed browser origins (empty = allow all, fine for mobile apps).
CORS_ORIGINS=

# Enables the /api/v1/admin endpoints (manual approve / reject / disburse).
ADMIN_API_KEY=

# Demo mode: return the OTP in the API response because no SMS/email provider is configured.
# Set to false once Twilio / Resend are configured below.
OTP_DEV_MODE=true
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5

# Simulated loan pipeline (seconds after the previous step).
LOAN_REVIEW_DELAY_SECONDS=20
LOAN_DECISION_DELAY_SECONDS=40
LOAN_DISBURSAL_DELAY_SECONDS=20
LIFECYCLE_SWEEP_SECONDS=10

# Optional: real SMS via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional: real email via Resend
RESEND_API_KEY=
EMAIL_FROM=
